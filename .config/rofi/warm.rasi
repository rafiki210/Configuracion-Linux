/* ══════════════════════════════════════════════════════════════
   Rofi — Warm Minimal
   Copia a: ~/.config/rofi/warm.rasi
   Uso: rofi -show drun -theme ~/.config/rofi/warm.rasi
   ══════════════════════════════════════════════════════════════ */

* {
    bg:       #0E0B07F5;
    surface:  #1A120AFF;
    copper:   #C8924AFF;
    copper-b: #E8C87AFF;
    text:     #D4B896FF;
    text-s:   #7A6448FF;
    text-d:   #3D2E1EFF;
    urgent:   #8B3A2AFF;

    font:             "DM Mono Light 11";
    background-color: transparent;
    text-color:       @text;
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            440px;
    background-color: @bg;
    border:           1px;
    border-color:	@text-d;
    border-radius:    0;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
}

inputbar {
    background-color: @surface;
    border-bottom:    1px solid;
    border-color:	 @text-d;
    padding:          10px 14px;
    spacing:          0;
    children:         [prompt, entry];
}

prompt {
    enabled: false;
    background-color: transparent;
    text-color:       @text-s;
    padding-right:    8px;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "buscar...";
    placeholder-color: @text-d;
    cursor:           text;
}

listview {
    background-color: transparent;
    lines:            8;
    padding:          6px 0;
    scrollbar:        false;
}

element {
    background-color: transparent;
    text-color:       @text-s;
    padding:          8px 14px;
    orientation:      horizontal;
    spacing:          10px;
}

element selected.normal {
    background-color: transparent;
    text-color:       @copper-b;
    border-left:      2px solid; 
    border-color:	@copper;
    padding-left:     12px;
}

element urgent {
    text-color: @urgent;
}

element-icon {
    size:             16px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}

/* Sin message, mode-switcher, scrollbar */
message   { padding: 0; }
scrollbar { width: 0; }
